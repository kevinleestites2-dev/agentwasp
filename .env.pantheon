# ─────────────────────────────────────────────────────────────────
# WASP — Pantheon Configuration
# ─────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=  # AUTO on install

# ── Dashboard ─────────────────────────────────────────────────────
DASHBOARD_SECRET=   # AUTO on install
MEDIA_SIGNING_SECRET=  # AUTO on install
DASHBOARD_USER=forgemaster
DASHBOARD_PASSWORD=  # set during wasp onboard
DASHBOARD_PORT=8080
DASHBOARD_BIND=127.0.0.1

# ── Telegram bridge (Pantheon standard) ───────────────────────────
# Main bot: @Seekerclaw27_bot
TELEGRAM_BOT_TOKEN=8847391123:AAEvnj4sEtJABzxBE3jqP0IhhybQAwCL6q4
TELEGRAM_ALLOWED_USERS=7135054241
SCHEDULER_NOTIFY_CHAT_ID=7135054241

# ── LLM providers ─────────────────────────────────────────────────
# Primary: OpenRouter (free tier — DeepSeek R1 / Llama 3.3)
OPENROUTER_API_KEY=  # stored in GitHub Secrets
# Fallback providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

DEFAULT_PROVIDER=openrouter

# ── Model routing (Pantheon free tier) ────────────────────────────
# Opus  -> DeepSeek R1 (reasoning)
# Sonnet -> Llama 3.3 70B (general)
# Haiku  -> Gemma 3 27B (fast)
MODEL_OPUS=open_router/deepseek/deepseek-r1:free
MODEL_SONNET=open_router/meta-llama/llama-3.3-70b-instruct:free
MODEL_HAIKU=open_router/google/gemma-3-27b-it:free

# ── Pantheon Prime credentials ─────────────────────────────────────
GITHUB_TOKEN=  # stored in GitHub Secrets — GhostPrime + fleet ops

# Polymarket / ZeusPrime
POLYMARKET_API_KEY=c7b727d4-1cf5-8f32-47f8-a796439e0ca5
POLYMARKET_WALLET=0x369c2DDDBEb910c48356910069B2903b3Cb4d535

# Nexus Relay — OpenAgora bridge
NEXUS_RELAY_URL=https://nexus-relay-production.up.railway.app
NEXUS_RELAY_SECRET=pantheon_prime

# ── Advanced ───────────────────────────────────────────────────────
SOVEREIGN_MODE=true
WASP_HOST_DIR=/opt/wasp
